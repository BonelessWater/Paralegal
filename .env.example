# ============================================================================
# AMD MI300X + vLLM Configuration
# ============================================================================
# 
# INSTRUCTIONS FOR YOUR TEAMMATES:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the MODEL_NAME and MODEL_PATH below with your chosen legal model
# 3. Get your Hugging Face token from: https://huggingface.co/settings/tokens
# 4. Run the setup scripts in /setup/ directory
#
# ============================================================================

# ============================================================================
# HUGGING FACE MODEL CONFIGURATION
# ============================================================================

# Your Hugging Face Access Token
# Required for downloading models (especially gated models like Llama)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=your_token_here
HUGGINGFACE_ACCESS_TOKEN=your_token_here

# ============================================================================
# MODEL SELECTION - CHOOSE YOUR LEGAL MODEL
# ============================================================================

# Hugging Face Model Repository
# Examples of legal-focused models:
#   - "law-ai/InLegalBERT"                    (Legal domain BERT)
#   - "nlpaueb/legal-bert-base-uncased"       (Legal BERT)
#   - "pile-of-law/legalbert-large-1.7M-1"    (Large legal BERT)
#   - "law-ai/LegalBERT-large"                (Legal domain model)
#   - "meta-llama/Meta-Llama-3-8B-Instruct"   (General purpose - strong baseline)
#   - "mistralai/Mistral-7B-Instruct-v0.2"    (General purpose alternative)
#   - YOUR CUSTOM MODEL HERE
#
# Format: "organization/model-name" from Hugging Face Hub
MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# Local folder name for the downloaded model
# This will be created in ~/ai-legal-tender/models/
# Example: If MODEL_NAME is "law-ai/InLegalBERT", set this to "in-legal-bert"
MODEL_FOLDER=llama-3-8b

# ============================================================================
# vLLM SERVER CONFIGURATION
# ============================================================================

# vLLM API Server URL
# Default is localhost if running on same machine
# If running on AMD cloud server, use the server's IP/hostname
VLLM_BASE_URL=http://localhost:8000

# Maximum sequence length for the model
# Adjust based on your model's capabilities
# Common values: 2048, 4096, 8192, 16384
MAX_MODEL_LEN=4096

# Tensor parallelism size (number of GPUs to use)
# Set to 1 for single GPU, higher for multi-GPU setups
TENSOR_PARALLEL_SIZE=1

# Data type for model weights
# Options: float16, bfloat16, float32
# float16 is recommended for most cases (saves memory)
MODEL_DTYPE=float16

# ============================================================================
# LLM GENERATION PARAMETERS
# ============================================================================

# Default temperature for text generation (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
# Legal work typically uses 0.5-0.7 for balance
DEFAULT_TEMPERATURE=0.7

# Default max tokens to generate per request
DEFAULT_MAX_TOKENS=500

# API timeout in seconds
API_TIMEOUT=30

# ============================================================================
# OCR CONFIGURATION
# ============================================================================

# OCR Backend to use
# Options: paddle, easy, tesseract
# paddle = PaddleOCR (recommended for legal docs)
# easy = EasyOCR (good alternative)
# tesseract = Tesseract (CPU-based fallback)
OCR_BACKEND=paddle

# ============================================================================
# PROJECT PATHS
# ============================================================================

# Base directory for AI Legal Tender project on AMD server
# This is where models and data will be stored
PROJECT_ROOT=~/ai-legal-tender

# Path where models are downloaded and stored
MODELS_PATH=~/ai-legal-tender/models

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================

# Enable GPU memory optimization
# Set to true if running low on GPU memory
ENABLE_PREFIX_CACHING=false

# Quantization (if your model supports it)
# Options: awq, gptq, squeezellm, or leave empty for no quantization
QUANTIZATION=

# Trust remote code (required for some custom models)
# Set to true if your model requires custom code
TRUST_REMOTE_CODE=false

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# LEXISNEXIS SCRAPER CONFIGURATION (if using)
# ============================================================================

# LexisNexis Credentials
LEXISNEXIS_USERNAME=your_lexisnexis_username
LEXISNEXIS_PASSWORD=your_lexisnexis_password

# ============================================================================
# OPENAI API CONFIGURATION
# ============================================================================

# OpenAI API Key
# Used for:
# - Whisper audio transcription
# - Realtime voice API (Twilio integration)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# GOOGLE API CONFIGURATION
# ============================================================================

# Google API Key (for Google Messaging/Spaces)
GOOGLE_API_KEY=your_google_api_key_here
SPACE_ID=your_space_id_here

# ============================================================================
# TWILIO CONFIGURATION
# ============================================================================

# Twilio Account Credentials
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
CALLER_ID_NAME=your_caller_id_name

# Twilio API Key (for advanced features)
SID=your_twilio_api_key_sid
SECRET=your_twilio_api_key_secret

# ============================================================================
# NGROK CONFIGURATION
# ============================================================================

# Ngrok settings for webhook tunneling
# Get from: https://dashboard.ngrok.com/
NODE_ENV=development
PORT=8000
SERVER_DOMAIN=your_ngrok_domain.ngrok-free.dev

# ============================================================================
# AMD SERVER SSH CONFIGURATION
# ============================================================================

# SSH access to AMD MI300X server
SSH=ssh amd-knights@134.199.202.8
AMD_SSH_PASSWORD=your_ssh_password

# ============================================================================
# EMAIL FORWARDING
# ============================================================================

# Email forwarding addresses
EMAIL_FORWARD_FROM=your_forward_from@domain.com
EMAIL_FORWARD_TO=your_forward_to@domain.com

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# IMAP Configuration (for reading emails)
IMAP_HOST=imap.gmail.com

# Email Service
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_RECIPIENT=your_recipient@gmail.com

# Gmail Mailbox (for reading emails)
MAILBOX=[Gmail]/All Mail

# ============================================================================
# EXAMPLE DATA
# ============================================================================

# Path to example data file (for testing)
EXAMPLE_DATA_PATH=./example_data.json

# ============================================================================
# DEBUG CONFIGURATION
# ============================================================================

# Enable debug mode
DEBUG=True
